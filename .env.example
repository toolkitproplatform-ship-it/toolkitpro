# ==============================================
# Toolkit Pro - Environment Variables Template
# ==============================================
# এই ফাইলটি কপি করে `.env` নামে সেভ করুন
# এবং আসল মান (values) বসান।
# `.env` ফাইলটি Git-এ পুশ হবে না।
# ==============================================

# ----------------------------------------------
# Node.js Environment
# ----------------------------------------------
NODE_ENV=production

# ----------------------------------------------
# Server Configuration
# ----------------------------------------------
# Render.com এ PORT অটো সেট হয়, লোকালে 10000 ব্যবহার করুন
PORT=10000
HOST=0.0.0.0

# ----------------------------------------------
# Database Configuration (PostgreSQL)
# ----------------------------------------------
# Render.com এ DATABASE_URL অটো-জেনারেট হবে
# লোকাল ডেভেলপমেন্টে নিচের ফরম্যাট ব্যবহার করুন
DATABASE_URL=postgresql://toolkit_admin:your_password@localhost:5432/toolkit_pro

# Database Connection Pool Settings
DB_MAX_CONNECTIONS=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ----------------------------------------------
# Redis Cache Configuration
# ----------------------------------------------
# Render.com / Upstash এ REDIS_URL অটো-জেনারেট হবে
# লোকাল ডেভেলপমেন্টে নিচের ফরম্যাট ব্যবহার করুন
REDIS_URL=redis://localhost:6379

# Redis Options
REDIS_MAX_MEMORY=256mb
REDIS_EVICTION_POLICY=allkeys-lru
REDIS_ENABLE_PERSISTENCE=true

# ----------------------------------------------
# JWT Security
# ----------------------------------------------
# প্রোডাকশনে একটি শক্তিশালী সিক্রেট কী ব্যবহার করুন
# Render.com এ generateValue: true দিলে অটো-জেনারেট হবে
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ----------------------------------------------
# Google AdSense Configuration
# ----------------------------------------------
# আপনার AdSense পাবলিশার ID (https://adsense.google.com)
ADSENSE_PUBLISHER_ID=ca-pub-XXXXXXXXXXXXXXX

# AdSense Enable/Disable
ADSENSE_ENABLED=true
ADSENSE_AUTO_ADS=true

# Ad Slot IDs (AdSense ড্যাশবোর্ড থেকে কপি করুন)
ADSENSE_SLOT_HEADER=1234567890
ADSENSE_SLOT_SIDEBAR=2345678901
ADSENSE_SLOT_IN_CONTENT=3456789012
ADSENSE_SLOT_RESULT_PAGE=4567890123
ADSENSE_SLOT_MOBILE_BANNER=5678901234

# ----------------------------------------------
# CORS Configuration
# ----------------------------------------------
# প্রোডাকশনে নির্দিষ্ট ডোমেইন দিন
# ডেভেলপমেন্টে "*" ব্যবহার করুন
CORS_ORIGIN=*

# Allowed Methods
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS

# Allowed Headers
CORS_HEADERS=Content-Type,Authorization,X-Requested-With

# ----------------------------------------------
# Rate Limiting
# ----------------------------------------------
# সাধারণ API রেট লিমিট (১৫ মিনিটে ১০০ রিকোয়েস্ট)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Specific Limit (১ মিনিটে ৩০ রিকোয়েস্ট)
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_REQUESTS=30

# Authentication Limit (১৫ মিনিটে ৫ রিকোয়েস্ট)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5

# ----------------------------------------------
# Cache Configuration
# ----------------------------------------------
# ক্যাশ TTL (সেকেন্ড)
CACHE_TTL_DEFAULT=300
CACHE_TTL_TOOLS=600
CACHE_TTL_ADS=1800
CACHE_TTL_USER=60

# Cache Enable/Disable
CACHE_ENABLED=true

# ----------------------------------------------
# Logging Configuration
# ----------------------------------------------
# লগ লেভেল (error/warn/info/debug)
LOG_LEVEL=info

# লগ ফাইল পাথ
LOG_FILE_PATH=./logs

# লগ রিটেনশন (দিন)
LOG_RETENTION_DAYS=14

# ----------------------------------------------
# Email Configuration (Optional)
# ----------------------------------------------
# SMTP সেটিংস (ভবিষ্যত ব্যবহারের জন্য)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Toolkit Pro <noreply@toolkitpro.com>

# ----------------------------------------------
# Social Media OAuth (Optional)
# ----------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ----------------------------------------------
# Analytics (Optional)
# ----------------------------------------------
# Google Analytics
GA_TRACKING_ID=UA-XXXXXXXXX-X
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ----------------------------------------------
# CDN & Storage (Optional)
# ----------------------------------------------
# Cloudinary (ইমেজ আপলোডের জন্য)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# AWS S3 (ফাইল স্টোরেজের জন্য)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=toolkit-pro-storage

# ----------------------------------------------
# Security Headers
# ----------------------------------------------
# Content Security Policy
CSP_ENABLED=true
CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline' https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://pagead2.googlesyndication.com

# HSTS (HTTP Strict Transport Security)
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# ----------------------------------------------
# Feature Flags
# ----------------------------------------------
# কোন ফিচার এনাবল/ডিসেবল করবেন
FEATURE_USER_REGISTRATION=true
FEATURE_USER_LOGIN=true
FEATURE_TOOL_REVIEWS=true
FEATURE_TOOL_FAVORITES=true
FEATURE_TOOL_SHARING=true
FEATURE_DARK_MODE=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_PWA=true

# ----------------------------------------------
# Language & Localization
# ----------------------------------------------
# ডিফল্ট ভাষা
DEFAULT_LANGUAGE=en

# সাপোর্টেড ভাষাসমূহ (কমা দিয়ে আলাদা)
SUPPORTED_LANGUAGES=en,bn,hi,es,fr,de,ja,ko,zh,ar,pt,ru,tr,vi,id,th,fil,ms,it,nl

# ডিফল্ট টাইমজোন
DEFAULT_TIMEZONE=UTC

# ডিফল্ট কারেন্সি
DEFAULT_CURRENCY=USD

# ----------------------------------------------
# Performance Tuning
# ----------------------------------------------
# Node.js Cluster (মাল্টি-কোর)
CLUSTER_ENABLED=false
CLUSTER_WORKERS=2

# Compression
COMPRESSION_ENABLED=true
COMPRESSION_LEVEL=6

# Body Parser Limit
BODY_PARSER_LIMIT=10mb

# Timeout Settings
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000

# ----------------------------------------------
# Monitoring (Optional)
# ----------------------------------------------
# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn
SENTRY_ENABLED=false

# UptimeRobot (আপটাইম মনিটরিং)
UPTIME_ROBOT_API_KEY=your-uptime-robot-key

# ----------------------------------------------
# Deployment Settings
# ----------------------------------------------
# ডিবাগ মোড (শুধু ডেভেলপমেন্টে true)
DEBUG=false

# হট রিলোড (ডেভেলপমেন্ট)
HOT_RELOAD=true

# ==============================================
# নোটস (Notes):
# ==============================================
# 1. প্রোডাকশনে সব সিক্রেট Render.com-এ সেট করুন
# 2. .env ফাইল কখনো GitHub-এ পুশ করবেন না
# 3. .env.example শুধু টেমপ্লেট হিসাবে রাখুন
# 4. AdSense ID অ্যাপ্রুভালের পর আপডেট করুন
# 5. JWT_SECRET অবশ্যই শক্তিশালী রাখুন
# ==============================================
